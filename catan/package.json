{
  "name": "catan",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm start -w apps/backend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:back": "npm start -w apps/backend",
    "dev:front": "npm run dev -w apps/frontend",
    "dev": "concurrently -n backend,frontend -c cyan,magenta npm:dev:back npm:dev:front"
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "version": "0.1.0",
  "description": "A Colyseus multiplayer server",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
